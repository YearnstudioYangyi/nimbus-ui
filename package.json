{
  "name": "@yearnstudioyangyi/nimbus-ui",
  "version": "0.1.1",
  "description": "Nimbus UI - Next Design System & Motion Component Library for Vue 3",
  "packageManager": "pnpm@9.15.4",
  "type": "module",
  "main": "./dist/nimbus-ui.umd.cjs",
  "module": "./dist/nimbus-ui.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/nimbus-ui.js",
      "require": "./dist/nimbus-ui.umd.cjs"
    },
    "./resolver": {
      "types": "./dist/resolver.d.ts",
      "import": "./dist/nimbus-ui.js",
      "require": "./dist/nimbus-ui.umd.cjs"
    },
    "./style.css": "./dist/style.css",
    "./dist/style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css",
    "./dist/style.css"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YearnstudioYangyi/nimbus-ui.git"
  },
  "homepage": "https://github.com/YearnstudioYangyi/nimbus-ui#readme",
  "bugs": {
    "url": "https://github.com/YearnstudioYangyi/nimbus-ui/issues"
  },
  "author": "YearnStudio",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vue-tsc --project tsconfig.build.json --declaration --emitDeclarationOnly --outDir dist",
    "build:playground": "vite build --mode playground",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "dependencies": {
    "bootstrap-icons": "^1.11.3"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "^5.6.3",
    "vite": "^6.0.7",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.0"
  },
  "keywords": [
    "vue",
    "vue3",
    "nimbus",
    "nimbus-ui",
    "components",
    "ui",
    "design-system",
    "motion",
    "animation",
    "transitions"
  ],
  "license": "MIT"
}
